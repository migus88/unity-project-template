# Unity generated
/src/[Ll]ibrary/
/src/[Tt]emp/
/src/[Oo]bj/
/src/[Bb]uild/
/src/[Bb]uilds/
/src/[Ll]ogs/
/src/[Uu]ser[Ss]ettings/
/src/[Mm]emoryCaptures/
/src/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/src/[Aa]ssets/**/*.meta

# Autogenerated IDE/solution files
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables / StreamingAssets generated
/src/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/src/[Aa]ssets/[Ss]treamingAssets/aa.meta
/src/[Aa]ssets/[Ss]treamingAssets/aa/*

# Content Directories build output (Build/Content Directories)
/src/[Aa]ssets/[Ss]treamingAssets/[Cc]ontent/
/src/[Aa]ssets/[Ss]treamingAssets/[Cc]ontent.meta
/src/[Aa]ssets/[Ss]treamingAssets.meta

# Created by Unity when a scene is created from code
/src/[Pp]rojectSettings/SceneTemplateSettings.json

# Test runner results (CLI/batchmode runs)
/src/[Tt]est[Rr]esults*.xml
/src/[Tt]est[Rr]esults/

# Performance testing run data written into Resources during player builds
/src/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json
/src/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json.meta

# Editor tooling screenshots (Unity CLI capture_game_view)
/src/[Aa]ssets/[Tt]emp/
/src/[Aa]ssets/[Tt]emp.meta

# OS
.DS_Store
Thumbs.db

# NuGetForUnity (restored on open from packages.config)
/src/[Pp]ackages/nuget-packages/InstalledPackages/
# NuGetForUnity leaves tools/ (install.ps1) folders at the Packages root
/src/[Pp]ackages/*.[0-9]*.[0-9]*/
