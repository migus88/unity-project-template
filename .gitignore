# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated IDE/solution files
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Addressables / StreamingAssets generated
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Content Directories build output (Build/Content Directories)
/[Aa]ssets/[Ss]treamingAssets/[Cc]ontent/
/[Aa]ssets/[Ss]treamingAssets/[Cc]ontent.meta
/[Aa]ssets/[Ss]treamingAssets.meta

# Created by Unity when a scene is created from code
/[Pp]rojectSettings/SceneTemplateSettings.json

# Test runner results (CLI/batchmode runs)
/[Tt]est[Rr]esults*.xml
/[Tt]est[Rr]esults/

# Performance testing run data written into Resources during player builds
/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json
/[Aa]ssets/[Rr]esources/PerformanceTestRun*.json.meta

# Editor tooling screenshots (Unity CLI capture_game_view)
/[Aa]ssets/[Tt]emp/
/[Aa]ssets/[Tt]emp.meta

# OS
.DS_Store
Thumbs.db

# NuGetForUnity (restored on open from packages.config)
/[Pp]ackages/nuget-packages/InstalledPackages/
# NuGetForUnity leaves tools/ (install.ps1) folders at the Packages root
/[Pp]ackages/*.[0-9]*.[0-9]*/
