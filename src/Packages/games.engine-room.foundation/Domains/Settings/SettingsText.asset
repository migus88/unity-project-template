  <TableName>k__BackingField: Settings
  _entries:
  - _key: privacy
    _english: Privacy
    _polish: "Prywatno\u015B\u0107"
  - _key: send_data
    _english: Send gameplay data and crash reports
    _polish: "Wysy\u0142aj dane z rozgrywki i raporty o b\u0142\u0119dach"
  - _key: yes
    _english: Yes
    _polish: Tak
  - _key: no
    _english: No
    _polish: Nie
  - _key: privacy_policy
    _english: Privacy policy
    _polish: "Polityka prywatno\u015Bci"
  - _key: install_id
    _english: Install ID
    _polish: ID instalacji
  - _key: install_id_none
    _english: None (data sharing is off)
    _polish: "Brak (udost\u0119pnianie danych jest wy\u0142\u0105czone)"
  - _key: deletion_hint
    _english: 'To have your data deleted, quote this ID in a request (see the privacy policy). Note it before turning data sharing off: turning it off creates a new ID.'
    _polish: "Aby usun\u0105\u0107 swoje dane, podaj ten identyfikator w pro\u015Bbie (zobacz polityk\u0119 prywatno\u015Bci). Zapisz go przed wy\u0142\u0105czeniem udost\u0119pniania danych: wy\u0142\u0105czenie tworzy nowy identyfikator."
